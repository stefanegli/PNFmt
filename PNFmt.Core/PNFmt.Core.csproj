<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Let Roslyn resolve this .NET Standard project through a reference assembly. -->
        <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
        <RootNamespace>PNFmt</RootNamespace>
        <TargetFramework>netstandard2.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="pnfmt" />
        <InternalsVisibleTo Include="PNFmt.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="editorconfig" Version="0.18.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    </ItemGroup>
</Project>

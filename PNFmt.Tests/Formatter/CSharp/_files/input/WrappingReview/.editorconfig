root = true

[*.cs]
pnfmt_enabled = true
pnfmt_formatter = csharp
pnfmt_format = true
max_line_length = 80
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
csharp_wrap_array_initializer_style = chop_always
csharp_wrap_object_and_collection_initializer_style = chop_always
csharp_wrap_list_pattern = chop_always
csharp_wrap_ternary_expr_style = chop_if_long
csharp_wrap_before_ternary_opsigns = true
csharp_wrap_property_pattern = chop_if_long
csharp_wrap_linq_expressions = chop_if_long
csharp_wrap_before_linq_expression = true
csharp_keep_existing_linebreaks = false
csharp_wrap_arguments_style = chop_if_long
csharp_wrap_switch_expression = chop_if_long
pnfmt_csharp_wrap_tuple_style = chop_if_long

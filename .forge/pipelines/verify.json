{
  "schemaVersion": 3,
  "id": "verify",
  "name": "Build, validate and tag PNFmt",
  "description": "Complete validation on VELA. Continue a successful master build on demand to create its release tag on GitHub.",
  "artifactRetention": { "keepRuns": 10 },
  "triggers": [
    { "type": "manual" },
    { "type": "push", "branches": ["master"] }
  ],
  "runThrough": { "push": "build", "manual": "build", "schedule": "build" },
  "requiredCheck": { "throughStage": "build" },
  "stages": [
    {
      "id": "build",
      "name": "Build, test and package",
      "jobs": [
        {
          "id": "verify",
          "requires": { "os": "windows", "dotnetSdk": "10.0" },
          "reports": {
            "tests": { "paths": ["artifacts/coverage"] },
            "coverage": {
              "paths": ["artifacts/coverage"],
              "profile": "pnfmt-production-v1",
              "toolchain": "coverlet-10.0.1-reportgenerator-5.5.11",
              "expectedAssemblies": ["PNFmt.Core", "pnfmt"]
            }
          },
          "outputs": [
            { "name": "coverage", "path": "artifacts/coverage", "when": "always" },
            { "name": "performance", "path": "artifacts/performance", "when": "always" },
            { "name": "package", "path": "artifacts/packages" }
          ],
          "steps": [
            {
              "id": "validate",
              "type": "process",
              "executable": "powershell.exe",
              "arguments": [
                "-NoLogo", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass",
                "-File", "scripts/Invoke-ForgeBuild.ps1"
              ],
              "environment": {
                "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
                "DOTNET_NOLOGO": "1",
                "DOTNET_CLI_UI_LANGUAGE": "en",
                "VSLANG": "1033"
              },
              "timeoutSeconds": 3600
            }
          ]
        }
      ]
    },
    {
      "id": "tag",
      "name": "Create release tag",
      "jobs": [
        {
          "id": "release-tag",
          "manualTrigger": true,
          "manualTriggerLabel": "Create release tag",
          "constraints": { "sourceBranches": ["master"], "triggers": ["manual", "push"] },
          "requires": { "os": "windows", "dotnetSdk": "10.0" },
          "inputs": [{ "job": "verify", "artifact": "package", "path": "incoming/validated-package" }],
          "outputs": [{ "name": "release-tag", "path": "artifacts/release-tag" }],
          "steps": [
            {
              "id": "tag",
              "type": "process",
              "executable": "powershell.exe",
              "arguments": [
                "-NoLogo", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass",
                "-File", "scripts/New-ReleaseTag.ps1"
              ],
              "environment": { "GIT_TERMINAL_PROMPT": "0", "GCM_INTERACTIVE": "Never", "DOTNET_NOLOGO": "1" },
              "timeoutSeconds": 600
            }
          ]
        }
      ]
    }
  ]
}

root = true

[*.cs]
pnfmt_csharp_collapse_blank_lines = true
pnfmt_csharp_format = true
pnfmt_csharp_sort_modifiers = true
pnfmt_sort_entries = true

[*.csproj]
pnfmt_csproj_empty_lines_between_groups = 1
pnfmt_sort_entries = true

[*.editorconfig]
pnfmt_ini_merge_groups = false
pnfmt_ini_sort_groups = false
pnfmt_sort_entries = true

[*.ini]
pnfmt_ini_group_by_prefix = true
pnfmt_ini_merge_groups = false
pnfmt_ini_sort_groups = false
pnfmt_sort_entries = true

[*.resx]
pnfmt_resx_remove_documentation_comment = true
pnfmt_resx_remove_xsd_schema = true
pnfmt_resx_sort_comparer = OrdinalIgnoreCase
pnfmt_sort_entries = true

[*.rsp]
pnfmt_sort_entries = true

[*.slnx]
pnfmt_sort_entries = true

[*.xaml]
pnfmt_xaml_format = true

[*.xml]
pnfmt_xml_format = true
